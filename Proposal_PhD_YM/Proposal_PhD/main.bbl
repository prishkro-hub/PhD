      \field{title}{Measurement of photonuclear jet production in ultra-peripheral Pb+Pb collisions at \${\textbackslash}sqrt\{s\_\{{\textbackslash}text\{{NN}\}\}\} = 5.02\$ {TeV} with the {ATLAS} detector}
