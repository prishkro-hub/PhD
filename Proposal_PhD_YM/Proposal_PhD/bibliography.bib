@article{gevorkyan_space-time_1988,
	title = {Space-time picture of photon-nucleon interaction in the {QCD} born approximation},
	volume = {212},
	issn = {0370-2693},
	url = {https://www.sciencedirect.com/science/article/pii/0370269388905345},
	doi = {https://doi.org/10.1016/0370-2693(88)90534-5},
	abstract = {A model of photon-nucleon interactions in which the high-energy photon is transformed into a qq̄ pair in a pointlike way is considered. The interaction of this pair with a nucleon takes place via one gluon exchange. In such an approach, one can obtain the value of the photon-nucleon cross section σ(γN) with meaningful values of αs (αs⋍0.5). Using an independent fragmentation model, we calculate the x dependence of the inclusive photoproduction spectra for π0 mesons which is in agreement with the experimental data.},
	pages = {251--254},
	number = {2},
	journaltitle = {Physics Letters B},
	author = {Gevorkyan, S. R. and Kotzinian, Ar M. and Jaloyan, V. M.},
	date = {1988},
	file = {Submitted Version:/home/yftach/Zotero/storage/D2ENMRJC/Gevorkyan et al. - 1988 - Space-time picture of photon-nucleon interaction in the QCD born approximation.pdf:application/pdf},
}

