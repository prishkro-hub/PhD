}

@article{collaboration_measurement_2025,
	title = {Measurement of photonuclear jet production in ultra-peripheral Pb+Pb collisions at \${\textbackslash}sqrt\{s\_\{{\textbackslash}text\{{NN}\}\}\} = 5.02\$ {TeV} with the {ATLAS} detector},
	volume = {111},
	issn = {2470-0010, 2470-0029},
	url = {http://arxiv.org/abs/2409.11060},
	doi = {10.1103/PhysRevD.111.052006},
	abstract = {In ultra-relativistic heavy ion collisions at the {LHC}, each nucleus acts a sources of high-energy real photons that can scatter off the opposing nucleus in ultra-peripheral photonuclear (\${\textbackslash}gamma+A\$) collisions. Hard scattering processes initiated by the photons in such collisions provide a novel method for probing nuclear parton distributions in a kinematic region not easily accessible to other measurements. {ATLAS} has measured production of dijet and multi-jet final states in ultra-peripheral Pb+Pb collisions at \${\textbackslash}sqrt\{s\_\{{\textbackslash}text\{{NN}\}\}\} = 5.02\$ {TeV} using a data set recorded in 2018 with an integrated luminosity of 1.72 \${\textbackslash}text\{nb\}{\textasciicircum}\{-1\}\$. Photonuclear final states are selected by requiring a rapidity gap in the photon direction; this selects events where one of the outgoing nuclei remains intact. Jets are reconstructed using the anti-\$k\_{\textbackslash}text\{t\}\$ algorithm with radius parameter, \$R = 0.4\$. Triple-differential cross-sections, unfolded for detector response, are measured and presented using two sets of kinematic variables. The first set consists of the total transverse momentum (\$H\_{\textbackslash}text\{T\}\$),rapidity, and mass of the jet system. The second set uses \$H\_{\textbackslash}text\{T\}\$ and particle-level nuclear and photon parton momentum fractions, \$x\_{\textbackslash}text\{A\}\$ and \$z\_\{{\textbackslash}gamma\}\$, respectively. The results are compared with leading-order ({LO}) perturbative {QCD} calculations of photonuclear jet production cross-sections, where all {LO} predictions using existing fits fall below the data in the shadowing region. More detailed theoretical comparisons will allow these results to strongly constrain nuclear parton distributions, and these data provide results from the {LHC} directly comparable to early physics results at the planned Electron-Ion Collider.},
	pages = {052006},
	number = {5},
	journaltitle = {Physical Review D},
	shortjournal = {Phys. Rev. D},
	author = {Collaboration, {ATLAS}},
	urldate = {2025-10-13},
	date = {2025-03-19},
	langid = {english},
	eprinttype = {arxiv},
	eprint = {2409.11060 [nucl-ex]},
	keywords = {High Energy Physics - Experiment, Nuclear Experiment},
	file = {PDF:/home/yftach/Zotero/storage/2F7AJVCB/Collaboration - 2025 - Measurement of photonuclear jet production in ultra-peripheral Pb+Pb collisions at \$sqrt s_ text N.pdf:application/pdf},
}

@misc{avoni_upgrades_2025,
	title = {Upgrades of the {ATLAS} Zero Degree Calorimeter System for Run 3 at the Large Hadron Collider},
	url = {http://arxiv.org/abs/2509.05948},
	doi = {10.48550/arXiv.2509.05948},
	abstract = {Experimental studies of ultra-relativistic heavy ion collisions at the Large Hadron Collider ({LHC}) depend crucially on Zero Degree Calorimeters ({ZDCs}) that measure neutrons produced at near-beam rapidity in nucleus-nucleus collisions. In hadronic nuclear collisions these neutrons are mainly spectator neutrons, those that do not scatter from opposing nucleons during the collision. As a result, the {ZDCs} provide a vital probe of heavy ion collision geometry. The {ZDCs} are also essential in the study of ultra-peripheral collisions that are initiated by photons associated with the electric fields of one or both nuclei. Coherent photon emission typically leaves the photon emitter intact, making the observation of no {ZDC} signal, on one or both sides, a tag of such processes. The {ATLAS} {ZDCs}, built prior to Run 1 were substantially upgraded for {LHC} Run 3. The primary upgrades included replacement of the quartz Cherenkov radiator with H2doped fused silica rods; installation of fast air-core signal cables between the {ZDC} and the {ATLAS} {USA}15 cavern; new {LED}-based calibration system; and new electronics implemented for readout and fully-digital triggering. The {ZDCs} were also augmented with new “Reaction Plane Detectors” ({RPDs}) designed to measure the transverse centroid of multi-neutron showers to allow event-byevent reconstruction of the directed-flow plane in nuclear collisions. The Run 3 {ZDC} detectors, including the {RPDs}, are described in detail with emphasis on aspects that are new for Run 3.},
	number = {{arXiv}:2509.05948},
	publisher = {{arXiv}},
	author = {Avoni, Giulio and Bruschi, Marco and Canale, Gianluca and Citron, Zvi and Cole, Brian and Dahle, Eitan and Dziedzic, Bartosz and Glik, Bar and Grosse-Perdekamp, Matthias and Guo, Yhan and Korcy, Krzysztof and Hoppesch, Matthew and Housenga, Mason and Lantz, Chad and Liu, Yi and Longo, Riccardo and Lund, Samantha and {MacLean}, Daniel and Meneghini, Stefano and Milovanovic, Marco and Mladenovic, Goran and Mohapatra, Soumya and Rafee, Farah Mohammed and Moyal, Yftach and Sbarra, Carla and Sbrizzi, Antonio and Seidlitz, Blair and Shenkar, Shir and Steinberg, Peter and Sudit, Lion and Valuch, Daniel and Young, Kristopher},
	urldate = {2025-10-13},
	date = {2025-09-07},
	langid = {english},
	eprinttype = {arxiv},
	eprint = {2509.05948 [physics]},
	keywords = {High Energy Physics - Experiment, Nuclear Experiment, Physics - Instrumentation and Detectors},
	file = {PDF:/home/yftach/Zotero/storage/QKESWW3P/Avoni et al. - 2025 - Upgrades of the ATLAS Zero Degree Calorimeter System for Run 3 at the Large Hadron Collider.pdf:application/pdf},
