\contentsline {figure}{\numberline {1}{\ignorespaces The table describing the standard model. Quarks outlined in purple and leptons in green \blx@tocontentsinit {0}\cite {noauthor_standard_nodate}.}}{2}{figure.1}%
\contentsline {figure}{\numberline {2}{\ignorespaces Illustration of a flux tube breaking, generating new quarks and anti-quarks in the process \blx@tocontentsinit {0}\cite {greensite_introduction_2020}.}}{3}{figure.2}%
\contentsline {figure}{\numberline {3}{\ignorespaces (a) Quark fragmentation to hadrons induced by confinement forces; (b) quark/gluon cascades at high energies in QCD \blx@tocontentsinit {0}\cite {ali_jets_2011}.}}{3}{figure.3}%
\contentsline {figure}{\numberline {4}{\ignorespaces Product of the spectrum of equivalent photons and total photonuclear cross section for 10.6 A GeV gold nuclei (dotted curve) and 158 A GeV lead nuclei (solid curve) in the interactions with gold and lead targets, respectively. The regions of GR excitation, quasi-deuteron absorption,and $\Delta $-isobar excitation are shown. For comparison, a product of the photon spectrum at an energy of 158 A GeV and the partial cross sections of photonuclear reactions with \ce {^{83}_{}Bi} (dashed curve) is shown \blx@tocontentsinit {0}\cite {pshenichnov_electromagnetic_2011}.}}{6}{figure.4}%
\contentsline {figure}{\numberline {5}{\ignorespaces Contributions to hard $\gamma $p interactions: (a) direct, (b) VMD, and (c) anomalous. Only the basic graphs are illustrated; additional partonic activity is allowed in either case. The presence of spectator jets has been indicated by dashed lines, while full lines show partons that (may) give rise to high-$p_T$ jets \blx@tocontentsinit {0}\cite {schuler_towards_1993}.}}{7}{figure.5}%
\contentsline {figure}{\numberline {6}{\ignorespaces Typical leading-order Feynman graphs for diffractive di-jet photoproduction in UPCs of hadrons A and B. Graphs a and b correspond to the direct and resolved photon contributions,respectively \blx@tocontentsinit {0}\cite {guzey_diffractive_2016}.}}{8}{figure.6}%
\contentsline {figure}{\numberline {7}{\ignorespaces Illustration of the collision geometry as function of impact parameter b. The blue region represents the overlapping region in which collision participants interact hadronically, while nulceons in the red region are spectators to the event.}}{9}{figure.7}%
\contentsline {figure}{\numberline {8}{\ignorespaces Correlation between the total energy measured in the two sides of the ZDC and the total transverse energy measured in the ATLAS forward calorimeter (FCal). The faint second band above the main band results from events having in-time pileup \blx@tocontentsinit {0}\cite {cole_zero_2023}. }}{9}{figure.8}%
\contentsline {figure}{\numberline {9}{\ignorespaces A schema of the LHC complex with the injectors and different accelerator rings. Different facilities are color coded and dated \blx@tocontentsinit {0}\cite {lopienska_cern_2022}.}}{10}{figure.9}%
\contentsline {figure}{\numberline {10}{\ignorespaces Cut-away view of the ATLAS ID, which is designed to provide a high-precision reconstruction of charged-particle trajectories. The ID covers the pseudo-rapidity range $|\eta | < 2.5$ and has full coverage in $\phi $. It consists of a silicon Pixel detector at the innermost radii surrounded by a silicon microstrip detector (SCT) and a straw-tube detector, the TRT, that combines continuous tracking capabilities with particle identification based on transition radiation \blx@tocontentsinit {0}\cite {aad_atlas_2024}.}}{11}{figure.10}%
\contentsline {figure}{\numberline {11}{\ignorespaces Cut-away view of the ATLAS calorimeter system that measures the energies and positions of charged and neutral particles through interleaved absorber and active layers out to $|\eta | < 4.9$. LAr is used as the active medium for the electromagnetic calorimeters and all of the endcap and forward calorimeters; scintillating Tiles are used for hadron calorimetry in the central region.\blx@tocontentsinit {0}\cite {aad_atlas_2024}}}{11}{figure.11}%
\contentsline {figure}{\numberline {12}{\ignorespaces The distribution of energies, expressed in terms of number of neutrons, in the A and C sides of the ZDC for events having at least 1 neutron on each side. The 1, 2, 3, and 4 neutron peaks can be seen as well as a large enhancement at ~40 neutrons arising from Pb+Pb collision geometry and the physics of (charged) nuclear cluster formation which reduces the neutron yield in peripheral collisions \blx@tocontentsinit {0}\cite {cole_zero_2023}. }}{13}{figure.12}%
\contentsline {figure}{\numberline {13}{\ignorespaces Event display of a monojet event and its associated tracks and clusters in ATLAS \blx@tocontentsinit {0}\cite {collaboration_atlas_2020}. Tracks are seen as orange lines and calorimeter energy is seen as green (EM) and yellow (HAD) boxes, with size proportional to energy deposit. }}{14}{figure.13}%
\contentsline {figure}{\numberline {14}{\ignorespaces Representation of the cuts (in red lines) used to remove splash events. As expected, there is much higher contribution of splash events in the 0nXn (bottom two plots) sample due to the probability of neutral fragments reaching the ZDCs. }}{22}{figure.14}%
\contentsline {figure}{\numberline {15}{\ignorespaces Representation of the cuts (in red lines) used to remove OOT pileup.}}{23}{figure.15}%
\contentsline {figure}{\numberline {16}{\ignorespaces Plot of calibrated EM Topojets time with Gaussian fit. $5\sigma $ bands are shown in magenta to describe the cuts needed to reduce beam halo muons.}}{25}{figure.16}%
\contentsline {figure}{\numberline {17}{\ignorespaces $y_{jets}$ distribution for different MC samples. Nucleus emitting the probing $\gamma $ is traveling towards forward rapidity. The $\gamma \mathbb {P}$ contribution includes 2 peaks: one closer to mid-rapidity, which stems from events where the nucleus underwent coherent diffraction, and one closer to backward rapidity, where the diffraction was stemmed from incoherent interaction. }}{25}{figure.17}%
\contentsline {figure}{\numberline {18}{\ignorespaces Event Display of a single $\gamma A$ event with the nucleus emitting the photon going towards positive $\eta $. The event is overlaid with the edge gaps and the particle bands. Edge gaps are in gray,A side band in green and C side band in red, with the reference point being the mean di-jet position in $\eta $. This specific example also shows the edge case in which detector acceptance can change the answer.}}{26}{figure.18}%
\contentsline {figure}{\numberline {19}{\ignorespaces Diagram of the ML model. The track and topocluster maps receive the same treatment by two different instances of a ResNet 50 variant network, before being concatenated with tabular event data. Each of the ResNet blocks can generate activation maps of the filters associated with it. }}{28}{figure.19}%
\contentsline {figure}{\numberline {20}{\ignorespaces $\eta $-$\phi $ map of a single event, where both tracks and clusters are present. (a) Event map prior to rotation. (b) Post rotation. }}{29}{figure.20}%
\contentsline {figure}{\numberline {21}{\ignorespaces Confusion matrices for the training and testing samples for photon side discrimination. The plots show slight overfitting, but unbiased prediction on both samples.}}{31}{figure.21}%
\contentsline {figure}{\numberline {22}{\ignorespaces Accuracy plots for $\gamma A$ (left) and $\gamma \mathbb {P}$ (right) binned in $H_T$. Different colors assigned to the different methods used for the calculation.}}{32}{figure.22}%
\contentsline {figure}{\numberline {23}{\ignorespaces Accuracy plots for $\gamma A$ (left) and $\gamma \mathbb {P}$ (right) binned in $y_{jets}$. Different colors assigned to the different methods used for the calculation.}}{32}{figure.23}%
\contentsline {figure}{\numberline {24}{\ignorespaces Accuracy plots for 0nXn binned in $H_T$ (left) and $y_{jets}$ (right). ``Truth'' information defined by ZDC X direction.}}{33}{figure.24}%
\contentsline {figure}{\numberline {25}{\ignorespaces Confusion matrices for the training and testing samples for multi-class classification. Percentages sum along the columns to 100\%, thus showing the distribution of truth with respect to different predictions. There is some block structure showing separation of $\gamma \gamma $ from $\gamma A$ , $\gamma \mathbb {P}$ contributions, while there is some overlap between $\gamma \mathbb {P}$ and $\gamma \gamma $RR. }}{34}{figure.25}%
\contentsline {figure}{\numberline {26}{\ignorespaces Confusion matrices for the training and testing samples for binary $\gamma \gamma $ , $\gamma A$ where all $\gamma \gamma $ processes were labeled as one. Percentages sum along the columns to 100\%, thus showing the distribution of truth with respect to different predictions.}}{35}{figure.26}%
\contentsline {figure}{\numberline {27}{\ignorespaces Confusion matrices for the training and testing samples for $\gamma A$ and $\gamma \mathbb {P}$ processes. Percentages sum along the columns to 100\%, thus showing the distribution of truth with respect to different predictions.}}{35}{figure.27}%
\contentsline {figure}{\numberline {28}{\ignorespaces Confusion matrices for the training and testing samples for $\gamma \gamma $ and $\gamma \mathbb {P}$ processes. Percentages sum along the columns to 100\%, thus showing the distribution of truth with respect to different predictions.}}{36}{figure.28}%
\contentsline {figure}{\numberline {29}{\ignorespaces Diagram of the decision process for final sample classification based on the results of the different models.}}{36}{figure.29}%
\contentsline {figure}{\numberline {30}{\ignorespaces Plots of $y_{jets}$ for 0nXn (Left) and 0n0n (Right), separating out the different contributions according to the ML models. Events were selected based on the photon direction model such that the nucleus emitting the photon goes in positive rapidity.}}{37}{figure.30}%
